# This .gitignore file should be placed at the root of the Unity project repository.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# VS Code / Visual Studio generated files
/.vs/
/.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.VC.db
/*.crash
/*.slnx

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
sysinfo.txt

# Unity auto generated
/[Aa]ssets/Plugins/x86/
/[Aa]ssets/Plugins/x86_64/
/[Aa]ssets/AssetStoreTools*

# Autogenerated Asset Metadata files (only if ignored explicitly, but standard Unity keeps .meta files tracked)
# Note: DO NOT ignore .meta files in Assets/!
